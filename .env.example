# --- Database ---
DATABASE_URL="postgresql://bii:bii_password@localhost:5432/bii_localfinder?schema=public"
# Prisma migrations should use a direct/session-pooled connection, not the
# transaction pooler. For Supabase, see docs/DEPLOYMENT.md.
DIRECT_URL="postgresql://bii:bii_password@localhost:5432/bii_localfinder?schema=public"

# --- Redis / Jobs ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
# Optional separate key for password-reset code hashing. Falls back to
# JWT_SECRET; set it in production so rotation is independent.
PASSWORD_RESET_PEPPER=""
# Session cookies are HttpOnly by default. Lax works for a same-site web/API
# deployment; use "none" (and HTTPS) only when the web app and API are on
# different sites. COOKIE_SECURE is forced on in production.
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"

# --- File storage (S3-compatible / MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="bii_minio_admin"
S3_SECRET_KEY="bii_minio_password"
S3_BUCKET="bii-localfinder"
# REQUIRED in production and must differ from S3_BUCKET. Verification
# documents and dispute evidence are private objects; they must never land
# in the anonymously-readable public bucket.
S3_PRIVATE_BUCKET="bii-localfinder-private"
S3_FORCE_PATH_STYLE="true"
# Which backend to use. Leave unset to auto-detect: S3/MinIO when
# S3_ENDPOINT is reachable, otherwise the on-disk fallback (files written
# under apps/api/.local-storage) so uploads work with no external service.
# Set to "s3" or "local" to force one explicitly.
# STORAGE_DRIVER="local"
# Absolute base URL the API is reachable at, used to build file URLs from the
# local fallback (defaults to http://localhost:$API_PORT).
# API_PUBLIC_URL="http://localhost:4000"
# Where the local fallback stores objects (defaults to apps/api/.local-storage).
# LOCAL_STORAGE_DIR=""

# --- Maps (Mapbox OR Google Maps — pick one, abstracted behind MapProvider) ---
MAP_PROVIDER="mapbox"
MAP_PROVIDER_KEY=""

# --- Monitoring (optional, wired later) ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# --- Provider subscription payments (abstracted, not implemented yet) ---
SUBSCRIPTION_PAYMENT_PROVIDER="mock"

# --- AI-assisted request writing (optional — falls back to an offline
# keyword-based mock when unset, so the app runs without this key) ---
ANTHROPIC_API_KEY=""

# --- AI booking assistant (optional — Gemini API key, backend-only; falls
# back to an offline keyword-based mock when unset, so the app runs without
# this key). Keep this on the server: it must never reach the web bundle. ---
GEMINI_API_KEY=""
# Override the default model (gemini-flash-latest) if needed.
GEMINI_MODEL=""
# --- Groq API key (optional — tried BEFORE Gemini for the booking assistant
# and the AI search parser while the Gemini quota is exhausted; unset to fall
# back to Gemini, unset both for the offline mock. Backend-only: never reach
# the web bundle.) ---
GROQ_API_KEY=""
# Override the default model (openai/gpt-oss-120b) if needed.
GROQ_MODEL=""

# --- Semantic search embeddings (optional — falls back to an offline
# hashing-based mock when unset, so search stays functional, just without
# true semantic recall, until this key is set) ---
VOYAGE_API_KEY=""
# Cosine-distance cutoff (0=identical, 2=opposite) for a "semantically
# related" match. Lower = stricter/fewer false positives. Default 0.6.
SEMANTIC_SEARCH_MAX_DISTANCE="0.6"

# --- Public request → provider matching ---
# When a client broadcasts a request (or opens a direct request to competing
# quotes), the matcher scores providers on exact service, same/related
# category, semantic similarity, keyword overlap, distance, quality and
# budget, then notifies the strongest matches in the background.
# Minimum weighted score (0-100) for a non-exact match to be notified.
# Exact-service matches are always notified.
REQUEST_MATCH_MIN_SCORE=30
# Upper bound on providers notified per request (prevents a huge category
# from turning one request into hundreds of notifications).
REQUEST_MATCH_MAX_PROVIDERS=100
# How many edges around the requested category count as "related"
# (0=same category, 1=parent/child, 2=sibling/grandchild).
REQUEST_MATCH_RELATED_CATEGORY_DEPTH=2
# Cosine-distance cutoff for semantic candidate retrieval (lower = stricter).
REQUEST_MATCH_SEMANTIC_MAX_DISTANCE="0.6"
# Candidate caps — safety valves for very large catalogs.
REQUEST_MATCH_SEMANTIC_CANDIDATES=250
REQUEST_MATCH_KEYWORD_CANDIDATES=250
REQUEST_MATCH_EXACT_LIMIT=1000
REQUEST_MATCH_RELATED_LIMIT=750

# --- App ---
API_PORT=4000
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# In production, set ALLOW_VERCEL_PREVIEWS=true only if you really want any
# *.vercel.app origin to make credentialed API calls.
# ALLOW_VERCEL_PREVIEWS="false"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Password reset / email ---
# The web app's public base URL. Password-reset emails link to
# <WEB_URL>/reset-password?token=... and workspace invitations link to
# <WEB_URL>/invite/:token, so it must be reachable by the recipient.
WEB_URL="http://localhost:3000"

# Public canonical origin for the web app. Used in page metadata, canonical
# URLs, sitemap.xml and robots.txt. Falls back to WEB_URL when unset.
# NEXT_PUBLIC_SITE_URL="https://biilocalfinder.com"

# Search Console / Bing Webmaster verification tokens (optional).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# How long a reset link stays valid, in minutes. The link is single-use.
PASSWORD_RESET_EXPIRES_MINUTES=60

# HMAC pepper for workspace-invitation tokens. Set this in production so
# rotating JWT_SECRET does not invalidate outstanding invitations (the code
# falls back to JWT_SECRET, then a development-only constant).
# WORKSPACE_INVITE_PEPPER="a-long-random-string"

# --- Data retention (days) ---
# Scheduled daily; business records (bookings, reviews, disputes) are kept,
# but secrets, identity documents, and personalization signal expire.
RETENTION_AUTH_ARTIFACT_DAYS=30
RETENTION_READ_NOTIFICATION_DAYS=180
RETENTION_INTERACTION_DAYS=365
RETENTION_VERIFICATION_DOCUMENT_DAYS=180
RETENTION_DISPUTE_EVIDENCE_DAYS=365
RETENTION_APPLICATION_PII_DAYS=180

# Outbound email. Leave SMTP_HOST empty in development: the API then logs the
# message (including the reset link) instead of sending it, so the flow stays
# testable without credentials. Set SMTP_HOST to switch to real SMTP delivery
# via the SmtpEmailSender.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for implicit TLS (port 465)
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="app-password"
# EMAIL_FROM="Bii Localfinder <no-reply@yourdomain.com>"
