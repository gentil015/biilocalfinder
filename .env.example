# --- Database ---
DATABASE_URL="postgresql://bii:bii_password@localhost:5432/bii_localfinder?schema=public"

# --- Redis / Jobs ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- File storage (S3-compatible / MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="bii_minio_admin"
S3_SECRET_KEY="bii_minio_password"
S3_BUCKET="bii-localfinder"
S3_FORCE_PATH_STYLE="true"

# --- Maps (Mapbox OR Google Maps — pick one, abstracted behind MapProvider) ---
MAP_PROVIDER="mapbox"
MAP_PROVIDER_KEY=""

# --- Monitoring (optional, wired later) ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# --- Provider subscription payments (abstracted, not implemented yet) ---
SUBSCRIPTION_PAYMENT_PROVIDER="mock"

# --- AI-assisted request writing (optional — falls back to an offline
# keyword-based mock when unset, so the app runs without this key) ---
ANTHROPIC_API_KEY=""

# --- AI booking assistant (optional — Gemini API key, backend-only; falls
# back to an offline keyword-based mock when unset, so the app runs without
# this key). Keep this on the server: it must never reach the web bundle. ---
GEMINI_API_KEY=""
# Override the default model (gemini-flash-latest) if needed.
GEMINI_MODEL=""
# --- Groq API key (optional — tried BEFORE Gemini for the booking assistant
# and the AI search parser while the Gemini quota is exhausted; unset to fall
# back to Gemini, unset both for the offline mock. Backend-only: never reach
# the web bundle.) ---
GROQ_API_KEY=""
# Override the default model (openai/gpt-oss-120b) if needed.
GROQ_MODEL=""

# --- Semantic search embeddings (optional — falls back to an offline
# hashing-based mock when unset, so search stays functional, just without
# true semantic recall, until this key is set) ---
VOYAGE_API_KEY=""
# Cosine-distance cutoff (0=identical, 2=opposite) for a "semantically
# related" match. Lower = stricter/fewer false positives. Default 0.6.
SEMANTIC_SEARCH_MAX_DISTANCE="0.6"

# --- App ---
API_PORT=4000
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Password reset / email ---
# The web app's public base URL. Password-reset emails link to
# <WEB_URL>/reset-password?token=... so it must be reachable by the recipient.
WEB_URL="http://localhost:3000"

# How long a reset link stays valid, in minutes. The link is single-use.
PASSWORD_RESET_EXPIRES_MINUTES=60

# Outbound email. Leave SMTP_HOST empty in development: the API then logs the
# message (including the reset link) instead of sending it, so the flow stays
# testable without credentials. Set SMTP_HOST to switch to real SMTP delivery
# via the SmtpEmailSender.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for implicit TLS (port 465)
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="app-password"
# EMAIL_FROM="Bii Localfinder <no-reply@yourdomain.com>"
